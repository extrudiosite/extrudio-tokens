{
  "$description": "Extrudio's design tokens, the single source of every visual value, in the W3C Design Tokens format. Colour-critical rule: every surface is achromatic (chroma 0), so the chrome never tints a render. The one accent (brand) is for focus and the logo, never for surfaces; since look C (request 110) actions and progress take the foreground. Contrast of every pair the components use is in docs/DECISIONS.md. A rebrand edits the Brand group only.",
  "base": {
    "$description": "The same in both themes.",
    "brand": {
      "$description": "Brand (the L07 kit of 2026-09-28: its logo is drawn in brand and foreground)",
      "font-sans": {
        "$type": "fontFamily",
        "$value": "var(--font-brand-sans), ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\""
      },
      "font-mono": {
        "$type": "fontFamily",
        "$value": "var(--font-geist-mono), ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
      },
      "radius": { "$type": "dimension", "$value": "0.625rem" }
    },
    "neutral": {
      "$description": "Neutral scale (chroma 0)",
      "neutral-0": { "$type": "color", "$value": "oklch(1 0 0)" },
      "neutral-25": { "$type": "color", "$value": "oklch(0.99 0 0)" },
      "neutral-50": { "$type": "color", "$value": "oklch(0.98 0 0)" },
      "neutral-100": { "$type": "color", "$value": "oklch(0.965 0 0)" },
      "neutral-150": { "$type": "color", "$value": "oklch(0.945 0 0)" },
      "neutral-200": { "$type": "color", "$value": "oklch(0.915 0 0)" },
      "neutral-300": { "$type": "color", "$value": "oklch(0.86 0 0)" },
      "neutral-400": { "$type": "color", "$value": "oklch(0.72 0 0)" },
      "neutral-500": { "$type": "color", "$value": "oklch(0.62 0 0)" },
      "neutral-600": { "$type": "color", "$value": "oklch(0.5 0 0)" },
      "neutral-700": { "$type": "color", "$value": "oklch(0.37 0 0)" },
      "neutral-800": { "$type": "color", "$value": "oklch(0.26 0 0)" },
      "neutral-850": { "$type": "color", "$value": "oklch(0.22 0 0)" },
      "neutral-900": { "$type": "color", "$value": "oklch(0.19 0 0)" },
      "neutral-925": { "$type": "color", "$value": "oklch(0.17 0 0)" },
      "neutral-950": { "$type": "color", "$value": "oklch(0.13 0 0)" },
      "neutral-1000": { "$type": "color", "$value": "oklch(0.16 0 0)" }
    },
    "motion": {
      "$description": "Motion (durations drop to near zero under prefers-reduced-motion, see index.css)",
      "ease-standard": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "ease-emphasized": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.3, 0, 0, 1)"
      }
    },
    "type": {
      "$description": "Type sizes, behind text-xs to text-6xl: a step under Tailwind's from sm up, since Plus Jakarta Sans sets large (request 90). xs stays 12 px, the smallest the app sets. A typeface that sets smaller swaps this group with the font.",
      "type-xs": { "$type": "dimension", "$value": "0.75rem" },
      "type-sm": { "$type": "dimension", "$value": "0.8125rem" },
      "type-base": { "$type": "dimension", "$value": "0.9375rem" },
      "type-lg": { "$type": "dimension", "$value": "1.0625rem" },
      "type-xl": { "$type": "dimension", "$value": "1.1875rem" },
      "type-2xl": { "$type": "dimension", "$value": "1.375rem" },
      "type-3xl": { "$type": "dimension", "$value": "1.75rem" },
      "type-4xl": { "$type": "dimension", "$value": "2.125rem" },
      "type-5xl": { "$type": "dimension", "$value": "2.8125rem" },
      "type-6xl": { "$type": "dimension", "$value": "3.5rem" }
    },
    "display": {
      "$description": "Display sizes for headlines above text-6xl, the site's (the showroom, 2026-11-08): each steps up from 48rem and from 80rem wide, set tight, behind text-display-1 to text-display-3. The app sets none.",
      "type-display-1": {
        "$type": "dimension",
        "$value": "2.75rem",
        "$extensions": {
          "from-width": { "48rem": "5.5rem", "80rem": "7rem" }
        }
      },
      "type-display-2": {
        "$type": "dimension",
        "$value": "2.5rem",
        "$extensions": {
          "from-width": { "48rem": "4.5rem", "80rem": "5.25rem" }
        }
      },
      "type-display-3": {
        "$type": "dimension",
        "$value": "2.125rem",
        "$extensions": { "from-width": { "48rem": "3.5rem" } }
      },
      "type-display-tracking": { "$type": "dimension", "$value": "-0.045em" },
      "type-display-leading": { "$type": "number", "$value": "0.98" }
    }
  },
  "light": {
    "$description": "The light theme: every themed token.",
    "brand": {
      "$description": "Brand (the L07 kit of 2026-09-28: its logo is drawn in brand and foreground)",
      "brand": { "$type": "color", "$value": "oklch(0.53 0.21 264)" },
      "brand-foreground": { "$type": "color", "$value": "oklch(0.99 0 0)" }
    },
    "surfaces": {
      "$description": "Surfaces and text",
      "background": { "$type": "color", "$value": "{base.neutral.neutral-0}" },
      "foreground": {
        "$type": "color",
        "$value": "{base.neutral.neutral-1000}"
      },
      "card": { "$type": "color", "$value": "{base.neutral.neutral-0}" },
      "card-foreground": {
        "$type": "color",
        "$value": "{light.surfaces.foreground}"
      },
      "popover": { "$type": "color", "$value": "{base.neutral.neutral-0}" },
      "popover-foreground": {
        "$type": "color",
        "$value": "{light.surfaces.foreground}"
      },
      "muted": { "$type": "color", "$value": "{base.neutral.neutral-100}" },
      "muted-foreground": {
        "$type": "color",
        "$value": "{base.neutral.neutral-600}"
      },
      "stage": {
        "$type": "color",
        "$value": "{base.neutral.neutral-150}",
        "$description": "The stage behind a render: neutral mid-light grey, like a photographer's backdrop."
      },
      "panel": {
        "$type": "color",
        "$value": "oklch(0.985 0 0)",
        "$description": "A large quiet block that groups the start of a page, such as Home's: one step off the page, never behind a render."
      },
      "panel-raised": {
        "$type": "color",
        "$value": "{base.neutral.neutral-0}",
        "$description": "Tiles and bars that sit on a panel."
      },
      "sidebar": {
        "$type": "color",
        "$value": "oklch(0.985 0 0)",
        "$description": "The app's sidebar: one step below the page, so navigation reads as its own layer."
      },
      "sidebar-accent": { "$type": "color", "$value": "oklch(0.93 0 0)" }
    },
    "actions": {
      "$description": "Actions",
      "primary": {
        "$type": "color",
        "$value": "{light.surfaces.foreground}",
        "$description": "The primary action is the foreground (look C, request 110): black on light, white on dark. The brand's blue stays in the logo and focus."
      },
      "primary-foreground": {
        "$type": "color",
        "$value": "{base.neutral.neutral-0}"
      },
      "secondary": { "$type": "color", "$value": "{base.neutral.neutral-150}" },
      "secondary-foreground": {
        "$type": "color",
        "$value": "{light.surfaces.foreground}"
      },
      "accent": { "$type": "color", "$value": "{base.neutral.neutral-150}" },
      "accent-foreground": {
        "$type": "color",
        "$value": "{light.surfaces.foreground}"
      }
    },
    "feedback": {
      "$description": "Feedback",
      "destructive": { "$type": "color", "$value": "oklch(0.5 0.195 27.325)" },
      "destructive-foreground": {
        "$type": "color",
        "$value": "oklch(0.99 0 0)"
      },
      "success": { "$type": "color", "$value": "oklch(0.5 0.13 152)" },
      "success-foreground": { "$type": "color", "$value": "oklch(0.99 0 0)" },
      "warning": { "$type": "color", "$value": "oklch(0.52 0.105 68)" },
      "warning-foreground": { "$type": "color", "$value": "oklch(0.99 0 0)" }
    },
    "axes": {
      "$description": "The 3D view's axes: its arrows and ring, and the panel's rows that move along them (red sideways, green up, blue towards you), and a handle under the pointer",
      "axis-x": { "$type": "color", "$value": "oklch(0.626 0.193 23)" },
      "axis-y": { "$type": "color", "$value": "oklch(0.641 0.133 157.7)" },
      "axis-z": { "$type": "color", "$value": "oklch(0.544 0.191 267)" },
      "axis-active": { "$type": "color", "$value": "oklch(0.854 0.157 84.1)" }
    },
    "lines": {
      "$description": "Lines and focus",
      "border": { "$type": "color", "$value": "oklch(0 0 0 / 9%)" },
      "input": { "$type": "color", "$value": "oklch(0.62 0 0)" },
      "ring": { "$type": "color", "$value": "{light.brand.brand}" }
    },
    "glass": {
      "$description": "The shell's frosted surfaces (the sidebar, the top bar) and the soft achromatic light behind them; never over a render (principle 1).",
      "glass": { "$type": "color", "$value": "oklch(1 0 0 / 62%)" },
      "glass-line": { "$type": "color", "$value": "oklch(0 0 0 / 8%)" },
      "glass-highlight": { "$type": "color", "$value": "oklch(1 0 0 / 70%)" },
      "glow": { "$type": "color", "$value": "oklch(0 0 0 / 3%)" },
      "glow-2": { "$type": "color", "$value": "oklch(0 0 0 / 2%)" }
    },
    "elevation": {
      "$description": "Elevation",
      "elevation-1": {
        "$type": "shadow",
        "$value": "0 1px 2px oklch(0 0 0 / 0.06)"
      },
      "elevation-2": {
        "$type": "shadow",
        "$value": "0 1px 3px oklch(0 0 0 / 0.08), 0 4px 12px oklch(0 0 0 / 0.06)"
      },
      "elevation-3": {
        "$type": "shadow",
        "$value": "0 8px 24px oklch(0 0 0 / 0.12), 0 2px 6px oklch(0 0 0 / 0.06)"
      },
      "elevation-4": {
        "$type": "shadow",
        "$value": "0 24px 64px oklch(0 0 0 / 0.2), 0 4px 12px oklch(0 0 0 / 0.08)"
      }
    }
  },
  "dark": {
    "$description": "The dark theme: only what differs from light. Off-black layers, lightest on top: sidebar < page < card < popover < muted.",
    "brand": {
      "brand": { "$type": "color", "$value": "oklch(0.7 0.155 264)" },
      "brand-foreground": { "$type": "color", "$value": "oklch(0.16 0 0)" }
    },
    "surfaces": {
      "background": { "$type": "color", "$value": "oklch(0.145 0 0)" },
      "foreground": { "$type": "color", "$value": "oklch(0.97 0 0)" },
      "card": { "$type": "color", "$value": "oklch(0.165 0 0)" },
      "card-foreground": {
        "$type": "color",
        "$value": "{dark.surfaces.foreground}"
      },
      "popover": { "$type": "color", "$value": "oklch(0.18 0 0)" },
      "popover-foreground": {
        "$type": "color",
        "$value": "{dark.surfaces.foreground}"
      },
      "muted": { "$type": "color", "$value": "oklch(0.21 0 0)" },
      "muted-foreground": { "$type": "color", "$value": "oklch(0.76 0 0)" },
      "stage": { "$type": "color", "$value": "oklch(0.2 0 0)" },
      "panel": { "$type": "color", "$value": "oklch(0.16 0 0)" },
      "panel-raised": { "$type": "color", "$value": "oklch(0.19 0 0)" },
      "sidebar": { "$type": "color", "$value": "oklch(0.12 0 0)" },
      "sidebar-accent": { "$type": "color", "$value": "oklch(0.2 0 0)" }
    },
    "actions": {
      "primary": { "$type": "color", "$value": "{dark.surfaces.foreground}" },
      "primary-foreground": { "$type": "color", "$value": "oklch(0.16 0 0)" },
      "secondary": { "$type": "color", "$value": "oklch(0.2 0 0)" },
      "secondary-foreground": {
        "$type": "color",
        "$value": "{dark.surfaces.foreground}"
      },
      "accent": { "$type": "color", "$value": "oklch(0.21 0 0)" },
      "accent-foreground": {
        "$type": "color",
        "$value": "{dark.surfaces.foreground}"
      }
    },
    "feedback": {
      "destructive": { "$type": "color", "$value": "oklch(0.72 0.16 25)" },
      "destructive-foreground": {
        "$type": "color",
        "$value": "oklch(0.16 0 0)"
      },
      "success": { "$type": "color", "$value": "oklch(0.75 0.15 150)" },
      "success-foreground": { "$type": "color", "$value": "oklch(0.16 0 0)" },
      "warning": { "$type": "color", "$value": "oklch(0.8 0.14 75)" },
      "warning-foreground": { "$type": "color", "$value": "oklch(0.16 0 0)" }
    },
    "axes": {
      "$description": "The 3D view's axes: its arrows and ring, and the panel's rows that move along them (red sideways, green up, blue towards you), and a handle under the pointer",
      "axis-x": { "$type": "color", "$value": "oklch(0.626 0.193 23)" },
      "axis-y": { "$type": "color", "$value": "oklch(0.641 0.133 157.7)" },
      "axis-z": { "$type": "color", "$value": "oklch(0.544 0.191 267)" },
      "axis-active": { "$type": "color", "$value": "oklch(0.854 0.157 84.1)" }
    },
    "lines": {
      "border": { "$type": "color", "$value": "oklch(1 0 0 / 8%)" },
      "input": { "$type": "color", "$value": "oklch(1 0 0 / 38%)" }
    },
    "glass": {
      "glass": { "$type": "color", "$value": "oklch(0.16 0 0 / 55%)" },
      "glass-line": { "$type": "color", "$value": "oklch(1 0 0 / 9%)" },
      "glass-highlight": { "$type": "color", "$value": "oklch(1 0 0 / 7%)" },
      "glow": { "$type": "color", "$value": "oklch(1 0 0 / 8%)" },
      "glow-2": { "$type": "color", "$value": "oklch(1 0 0 / 4%)" }
    },
    "elevation": {
      "elevation-1": {
        "$type": "shadow",
        "$value": "0 1px 2px oklch(0 0 0 / 0.35)"
      },
      "elevation-2": {
        "$type": "shadow",
        "$value": "0 1px 3px oklch(0 0 0 / 0.4), 0 4px 12px oklch(0 0 0 / 0.3)"
      },
      "elevation-3": {
        "$type": "shadow",
        "$value": "0 8px 24px oklch(0 0 0 / 0.45), 0 2px 6px oklch(0 0 0 / 0.35)"
      },
      "elevation-4": {
        "$type": "shadow",
        "$value": "0 24px 64px oklch(0 0 0 / 0.55), 0 4px 12px oklch(0 0 0 / 0.4)"
      }
    }
  }
}
